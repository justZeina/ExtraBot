{
  "_metadata": { "major_version": 1 },
  "display_information": {
    "name": "ExtraBot",
    "description": "Internal extras request approvals and delivery planning"
  },
  "features": {
    "bot_user": { "display_name": "ExtraBot", "always_online": false },
    "shortcuts": [
      { "name": "New Extra Request", "callback_id": "extra_new", "description": "Create an extras request", "type": "global" }
    ],
    "slash_commands": [
      { "command": "/extra", "description": "Create or view extras requests", "usage_hint": "new | list | <request ID>", "should_escape": false }
    ]
  },
  "oauth_config": { "scopes": { "bot": ["commands", "chat:write", "im:write"] } },
  "settings": {
    "interactivity": { "is_enabled": true },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
